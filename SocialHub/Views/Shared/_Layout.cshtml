
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SocialHub</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    SocialHub
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home"
                               asp-action="Index">Головна</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Post"
                               asp-action="Index">Усі пости</a>
                        </li>
                        <li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a class="nav-link text-white"
                               asp-controller="Post"
                               asp-action="Create">
                                Створити пост
                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="nav-link text-white border-0 bg-transparent"
                                    data-bs-toggle="modal"
                                    data-bs-target="#authModal">
                                Створити пост
                            </button>
                        }
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="text-white">
                                Привіт, @User.Identity.Name!
                            </span>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">
                                <button type="submit" class="btn btn-outline-light">
                                    Вийти
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-outline-light">
                                Увійти
                            </a>

                            <a asp-controller="Account"
                               asp-action="Register"
                               class="btn btn-success">
                                Реєстрація
                            </a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-5 py-3">
        <div class="container">
            &copy; 2026 - SocialHub
        </div>
    </footer>

<div class="modal fade" id="authModal" tabindex="-1" aria-labelledby="authModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="authModalLabel">Потрібна авторизація</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрити"></button>
            </div>

            <div class="modal-body text-center">
                Щоб створювати пости та коментарі, потрібно увійти в акаунт або зареєструватися.
            </div>

            <div class="modal-footer justify-content-center">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                    Увійти
                </a>

                <a asp-controller="Account" asp-action="Register" class="btn btn-success">
                    Реєстрація
                </a>
            </div>
        </div>
    </div>
</div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>


@model SocialHub.Models.Comment

@{
    ViewData["Title"] = "Додати коментар";
}

<h1>Додати коментар</h1>

<form asp-controller="Comment" asp-action="Create" method="post">
    <input type="hidden" name="PostId" value="@ViewBag.PostId" />

    <div class="mb-3">
        <label asp-for="Text" class="form-label">
            Текст коментаря
        </label>
        <textarea asp-for="Text" class="form-control"
                  rows="4" required></textarea>
    </div>

    <button type="submit" class="btn btn-success">
        Додати коментар
    </button>

    <a asp-controller="Post"
       asp-action="Details"
       asp-route-id="@ViewBag.PostId"
       class="btn btn-secondary">
        Назад до поста
    </a>
</form>
